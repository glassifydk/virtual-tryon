      "default": "Birthdate:"
    },
    {
      "type": "text",
      "id": "sub_total_text",
      "label": "Sub total text",
      "default": "Sub Total"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "Shipping"
